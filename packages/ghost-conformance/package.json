{
  "name": "@ts-ghost/ghost-conformance",
  "private": true,
  "version": "0.0.0",
  "description": "Live conformance suite: the public admin-api client against a pinned, official Ghost in Docker.",
  "type": "module",
  "scripts": {
    "test": "vitest --typecheck run",
    "test:watch": "vitest --typecheck",
    "test:manifest": "vitest run -c ./vitest.config.manifest.ts",
    "lint": "eslint ./src --fix",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "manifest": "node src/manifest/generate.ts",
    "coverage": "node src/route-coverage/report.ts",
    "clean": "rimraf .turbo"
  },
  "devDependencies": {
    "@ts-ghost/admin-api": "workspace:*",
    "@ts-ghost/core-api": "workspace:*",
    "@ts-ghost/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:eslint",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
