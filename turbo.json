{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "GHOST_URL",
    "GHOST_CONTENT_API_KEY",
    "GHOST_ADMIN_API_KEY",
    "GHOST_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".cache", ".next/**", "public/build/**", "build/**"]
    },
    "clean": {
      "outputs": ["dist/**", ".cache", ".next/**", "public/build/**", "build/**"]
    },
    "start": {
      "dependsOn": ["^build"],
      "outputs": ["public/build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:watch": {
      "outputs": []
    },
    "test:coverage": {
      "outputs": ["coverage"]
    },
    "test-ci": {
      "outputs": ["coverage"]
    },
    "typecheck": {
      "outputs": []
    },
    "format:write": {
      "outputs": []
    },
    "format": {
      "outputs": []
    }
  }
}
